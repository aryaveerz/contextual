# ==============================================================================
# Contextual: Environment Configuration (.env.example)
# ==============================================================================

# FalkorDB Database Configuration
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=contextual_security_graph
FALKORDB_TIMEOUT_MS=5000

# Cryptographic Keys (Must be distinct 64-char hexadecimal strings, 32 bytes each)
TENANT_MASTER_KEY_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_JWT_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Multi-Tenant Default (DEFAULT_ACTIVE_TENANT is also supported as an alias)
DEFAULT_TENANT_ID=tenant-corp-alpha

# Application Policy & Query Bounds
MAX_TRAVERSAL_DEPTH=5
QUERY_ROW_CAP=100

# Server & Docker Host Port Configuration
# Set to 0 (or omit) for automatic collision-free kernel port allocation,
# or specify an explicit port (e.g. FRONTEND_PORT=3000, BACKEND_PORT=8000).
FRONTEND_PORT=0
BACKEND_PORT=0
BACKEND_HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional Infrastructure Remediation (GitHub API v3)
# When configured, Gate B remediation authorization dispatches real pull requests.
# If omitted or empty, proposals are safely recorded as PENDING in local durable store.
# GITHUB_TOKEN=ghp_example_token_here
# GITHUB_REPO=owner/repo_name
